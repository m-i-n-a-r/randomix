<?xml version="1.0" encoding="utf-8"?>
<!-- The row below gives the idle segments their color, the selected one is filled with the primary.
     Disabled, the selected one keeps only the standard faint fill, like its dimmed icon -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.12" android:color="?attr/colorOnSurface" android:state_checked="true" android:state_enabled="false" />
    <item android:color="?attr/colorPrimary" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
