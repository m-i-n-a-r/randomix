<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rouletteScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rouletteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleRoulette"
            style="@style/Widget.App.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hello_roulette_fragment" />

        <TextView
            android:id="@+id/descriptionRoulette"
            style="@style/Widget.App.PageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description_roulette" />

        <!-- The options: a field to add them, or the two bounds of the range, and their chips -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rouletteCard"
            style="@style/Widget.App.CardView.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/card_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- What the roulette picks from: the options below, or a range of numbers -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.CardView.Tonal.Inner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dice_type_height"
                    android:layout_marginBottom="@dimen/card_padding">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/rouletteModeSelection"
                        style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:spacing="0dp"
                        app:checkedButton="@id/rouletteModeOptions"
                        app:innerCornerSize="@dimen/tonal_card_radius_inner"
                        app:selectionRequired="true"
                        app:shapeAppearance="@style/ShapeAppearance.App.TonalInner"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rouletteModeOptions"
                            style="@style/Widget.App.Button.TonalButton.Segment"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/roulette_mode_options" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rouletteModeRange"
                            style="@style/Widget.App.Button.TonalButton.Segment"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/range" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/textOptionRoulette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/recentButton"
                        android:layout_width="@dimen/field_button_size"
                        android:layout_height="@dimen/field_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/recent_title"
                        android:focusable="true"
                        android:hapticFeedbackEnabled="false"
                        android:padding="@dimen/field_button_icon_padding"
                        android:src="@drawable/recent_vector_animation" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.TextInputLayout.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/insert_roulette_hint"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/entryRoulette"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textAutoCorrect"
                            android:maxLength="20"
                            android:textCursorDrawable="@drawable/custom_cursor" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:id="@+id/insertButton"
                        android:layout_width="@dimen/field_button_size"
                        android:layout_height="@dimen/field_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/insert_roulette_hint"
                        android:focusable="true"
                        android:hapticFeedbackEnabled="false"
                        android:padding="@dimen/field_button_icon_padding"
                        android:src="@drawable/insert_vector_animation" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rangeOptionRoulette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.TextInputLayout.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/min"
                        app:startIconDrawable="@drawable/ic_range_min_24dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/rangeMinRoulette"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="5"
                            android:textCursorDrawable="@drawable/custom_cursor" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageView
                        android:id="@+id/animatedRangeRoulette"
                        android:layout_width="@dimen/range_icon_size"
                        android:layout_height="@dimen/range_icon_size"
                        android:contentDescription="@string/range"
                        android:padding="@dimen/linear_vertical_padding"
                        android:src="@drawable/animated_range_roulette" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.TextInputLayout.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/max"
                        app:startIconDrawable="@drawable/ic_range_max_24dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/rangeMaxRoulette"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="5"
                            android:textCursorDrawable="@drawable/custom_cursor" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- The options added so far, and the button to delete them all at once -->
                <LinearLayout
                    android:id="@+id/rouletteChipRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fadingEdgeLength="@dimen/chip_row_fading_edge"
                        android:requiresFadingEdge="horizontal"
                        android:scrollbars="none">

                        <!-- The inset is inside the scrolled content, so the scroll view keeps its
                             own bounds and the standard fading edge sits right on them -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/rouletteChipList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/card_padding"
                            android:animateLayoutChanges="true"
                            app:chipSpacing="@dimen/chip_spacing"
                            app:singleLine="true" />

                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteAllRoulette"
                        style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/delete_all_roulette"
                        app:icon="@drawable/animated_delete" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/buttonSpinRoulette"
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_button_height"
            android:layout_marginTop="@dimen/linear_vertical_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/spin_roulette"
            android:focusable="true"
            android:hapticFeedbackEnabled="false"
            android:src="@drawable/roulette_main_vector_animation" />

        <TextView
            android:id="@+id/resultRoulette"
            style="@style/Widget.App.PageResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/result_placeholder" />

    </LinearLayout>

</ScrollView>
