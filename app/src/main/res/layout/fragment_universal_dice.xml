<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/diceScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/diceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleDice"
            style="@style/Widget.App.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hello_dice_fragment" />

        <TextView
            android:id="@+id/descriptionDice"
            style="@style/Widget.App.PageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description_dice" />

        <!-- What to throw: the type of die and how many, the type is locked to D6 in 3 vs 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/diceCard"
            style="@style/Widget.App.CardView.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/card_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Icon only segments over an inner row, the selected one filled with the primary and
                     rounded like the row, since it touches its edges -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/diceTypeCard"
                    style="@style/Widget.App.CardView.Tonal.Inner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dice_type_height">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/diceTypeSelection"
                        style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:spacing="0dp"
                        app:innerCornerSize="@dimen/tonal_card_radius_inner"
                        app:selectionRequired="true"
                        app:shapeAppearance="@style/ShapeAppearance.App.TonalInner"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/diceTypeSelection4"
                            style="@style/Widget.App.Button.TonalButton.IconOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/dice_d4"
                            app:icon="@drawable/ic_dice_d4" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/diceTypeSelection6"
                            style="@style/Widget.App.Button.TonalButton.IconOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/dice_d6"
                            app:icon="@drawable/ic_dice_d6" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/diceTypeSelection8"
                            style="@style/Widget.App.Button.TonalButton.IconOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/dice_d8"
                            app:icon="@drawable/ic_dice_d8" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/diceTypeSelection10"
                            style="@style/Widget.App.Button.TonalButton.IconOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/dice_d10"
                            app:icon="@drawable/ic_dice_d10" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/diceTypeSelection12"
                            style="@style/Widget.App.Button.TonalButton.IconOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/dice_d12"
                            app:icon="@drawable/ic_dice_d12" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/diceTypeSelection20"
                            style="@style/Widget.App.Button.TonalButton.IconOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:contentDescription="@string/dice_d20"
                            app:icon="@drawable/ic_dice_d20" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/diceCountChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding"
                    android:paddingHorizontal="@dimen/card_padding"
                    app:chipSpacingHorizontal="@dimen/chip_spacing"
                    app:chipSpacingVertical="0dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount1"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/one_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount2"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/two_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount3"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/three_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount4"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/four_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount5"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/five_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount6"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/six_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount7"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seven_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount8"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eight_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount9"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nine_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCount10"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ten_numeral" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCountRisiko"
                        style="@style/Widget.App.Chip.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/three_v_three" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/resultDice"
            style="@style/Widget.App.PageResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="@string/result_placeholder" />

        <FrameLayout
            android:id="@+id/diceDisplayZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:contentDescription="@string/throw_dice"
            android:focusable="true"
            android:hapticFeedbackEnabled="false"
            android:paddingHorizontal="@dimen/activity_horizontal_margin">

            <ImageView
                android:id="@+id/universalDiceAnimation"
                android:layout_width="@dimen/image_button_height"
                android:layout_height="@dimen/image_button_height"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dice_d6" />

            <include
                android:id="@+id/risikoLayout"
                layout="@layout/triple_v_triple_dice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </FrameLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/diceResultCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            app:chipSpacingHorizontal="@dimen/chip_spacing"
            app:chipSpacingVertical="0dp" />

    </LinearLayout>

</ScrollView>
