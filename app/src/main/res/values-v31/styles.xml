<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pins the on*Container roles back to the wallpaper palette, see the base configuration -->
    <style name="ThemeOverlay.App.MonetContainerFix" parent="">
        <item name="colorOnPrimaryContainer">@android:color/system_accent1_900</item>
        <item name="colorOnSecondaryContainer">@android:color/system_accent1_900</item>
        <item name="colorOnTertiaryContainer">@android:color/system_accent2_900</item>
    </style>

    <!-- Splash screen theme -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/animated_randomix_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/static_branding_image</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>