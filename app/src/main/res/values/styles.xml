<resources>

    <!-- Empty on purpose, only light needs the fix: filled in on API 31+ -->
    <style name="ThemeOverlay.App.MonetContainerFix" parent="" />

    <!-- Style for the light theme -->
    <style name="AppTheme" parent="AppTheme.Base" />

    <style name="AppTheme.Base" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurfaceContainerLow">@color/colorBackground</item>
        <item name="colorOutlineVariant">@color/deepGray</item>
        <item name="colorOnPrimary">@color/deepGray</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorAccentVeil">@color/colorAccentTranslucent</item>
        <item name="colorPrimaryContainer">@color/colorAccentPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorAccentOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/textColorPrimary</item>
        <item name="colorSecondaryContainer">@color/colorAccentSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorAccentOnSecondaryContainer</item>
        <item name="colorTertiary">@color/colorAccentDark</item>
        <item name="colorTertiaryContainer">@color/colorAccentTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorAccentOnTertiaryContainer</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>
        <item name="android:textColorTertiary">@color/textColorSecondary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/MaterialSnackbarTextViewTheme</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/textColorPrimary</item>
        <item name="colorOnSurfaceVariant">@color/textColorPrimary</item>
        <item name="colorOnBackground">@color/textColorSecondary</item>
        <item name="materialSwitchStyle">@style/CustomMaterialSwitch</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="colorOutline">@color/goodGray</item>
        <item name="colorSurfaceVariant">@color/goodGrayTranslucent</item>
        <item name="android:dialogPreferenceStyle">@style/ThemeOverlay.App.PreferenceDialog.Monet</item>
        <item name="colorTonalCard">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- Monet theme -->
    <style name="AppTheme.Monet" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="colorAccentVeil">?attr/colorTertiaryContainer</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/MaterialSnackbarTextViewTheme</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog.Monet</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Monet</item>
        <item name="android:dialogPreferenceStyle">@style/ThemeOverlay.App.PreferenceDialog.Monet</item>
        <item name="colorTonalCard">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- Splash screen theme -->
    <style name="SplashTheme" parent="SplashTheme.Base.Legacy" />

    <style name="SplashTheme.Base" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:navigationBarColor">?attr/colorOutline</item>
    </style>

    <style name="SplashTheme.Base.Legacy">
        <item name="android:windowBackground">@drawable/static_randomix_light</item>
    </style>

    <!-- Preference dialog theme -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="dialogCornerRadius">@dimen/rounded_corners</item>
        <!-- Remove the accent-ish tint -->
        <item name="backgroundTint">?colorBackgroundFloating</item>
        <item name="android:backgroundTint">?colorBackgroundFloating</item>
    </style>

    <!-- Preference dialog Monet theme -->
    <style name="ThemeOverlay.App.MaterialAlertDialog.Monet" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
        <item name="dialogCornerRadius">@dimen/rounded_corners</item>
        <item name="android:background">@drawable/dialog_bg_monet</item>
    </style>

    <style name="ThemeOverlay.App.PreferenceDialog.Monet" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="dialogCornerRadius">@dimen/rounded_corners</item>
        <item name="android:background">@drawable/dialog_bg_monet</item>
    </style>

    <!-- Note: shape appearance doesn't work with the preference dialogs (they're not material) -->
    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.Material3Expressive">
        <item name="shapeAppearance">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <!-- Snackbar style -->
    <style name="Widget.App.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/snackbar_background</item>
    </style>

    <style name="MaterialSnackbarTextViewTheme" parent="@style/Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:maxLines">20</item>
    </style>

    <!-- Bottom sheet -->
    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <!-- Remove the accent-ish tint -->
        <item name="backgroundTint">?colorSurfaceContainerLow</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog.Monet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/rounded_corners</item>
    </style>

    <!-- Switch for non-monet accents, probably useless -->
    <style name="CustomMaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbIconTint">?attr/colorPrimary</item>
    </style>

    <!-- Icon only segments of the dice type selector, inside the dice card -->
    <style name="Widget.App.Button.TonalButton.IconOnly" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">20dp</item>
        <item name="android:minHeight">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/type_selector_background</item>
        <item name="iconTint">@color/type_selector_icon</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- The same, with a label instead of an icon: the mode of the roulette -->
    <style name="Widget.App.Button.TonalButton.Segment" parent="Widget.App.Button.TonalButton.IconOnly">
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textColor">@color/type_selector_icon</item>
    </style>

    <!-- Tonal text field: filled with the veil, no box stroke and no underline, all corners round -->
    <style name="Widget.App.TextInputLayout.Tonal" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/tonal_field_background</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/text_field_corner</item>
        <item name="boxCornerRadiusTopEnd">@dimen/text_field_corner</item>
        <item name="boxCornerRadiusBottomStart">@dimen/text_field_corner</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/text_field_corner</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="startIconTint">?attr/colorOnSecondaryContainer</item>
        <item name="endIconTint">?attr/colorOnSecondaryContainer</item>
    </style>

    <!-- The same, for the fields opening a dropdown -->
    <style name="Widget.App.TextInputLayout.Tonal.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/tonal_field_background</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/text_field_corner</item>
        <item name="boxCornerRadiusTopEnd">@dimen/text_field_corner</item>
        <item name="boxCornerRadiusBottomStart">@dimen/text_field_corner</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/text_field_corner</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="startIconTint">?attr/colorOnSecondaryContainer</item>
        <item name="endIconTint">?attr/colorOnSecondaryContainer</item>
    </style>

    <!-- Rounded like the inside of a tonal card, for what sits within one -->
    <style name="ShapeAppearance.App.TonalInner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tonal_card_radius_inner</item>
    </style>

    <!-- Tonal elevated card, the look replacing the outlined cards -->
    <style name="Widget.App.CardView.Tonal" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorTonalCard</item>
        <item name="cardCornerRadius">@dimen/tonal_card_radius</item>
        <item name="cardElevation">@dimen/tonal_card_elevation</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- A card inside a tonal card: no shadow of its own, a denser veil than the fields -->
    <style name="Widget.App.CardView.Tonal.Inner">
        <item name="cardBackgroundColor">@color/inner_card_background</item>
        <item name="cardCornerRadius">@dimen/tonal_card_radius_inner</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- The three texts every tool page is made of: its title, a short description, the result.
         The title owns the space below it, so the page keeps its rhythm with the descriptions
         hidden too -->
    <style name="Widget.App.PageTitle" parent="">
        <item name="android:layout_marginTop">@dimen/activity_vertical_margin</item>
        <item name="android:layout_marginBottom">@dimen/activity_vertical_margin</item>
        <item name="android:layout_marginStart">@dimen/activity_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/activity_horizontal_margin</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.HeadlineMedium.Emphasized</item>
        <item name="android:textColor">?attr/colorTertiary</item>
    </style>

    <style name="Widget.App.PageDescription" parent="">
        <item name="android:layout_marginStart">@dimen/linear_vertical_margin</item>
        <item name="android:layout_marginEnd">@dimen/linear_vertical_margin</item>
        <item name="android:layout_marginBottom">@dimen/activity_vertical_margin</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="Widget.App.PageResult" parent="">
        <item name="android:layout_marginStart">@dimen/activity_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/activity_horizontal_margin</item>
        <item name="android:layout_marginTop">@dimen/result_text_margin</item>
        <item name="android:layout_marginBottom">@dimen/result_text_margin</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textSize">@dimen/result_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tonal chip: the veil of the fields when idle, the primary when checked, like the icon
         segments. No stroke, as everywhere else -->
    <style name="Widget.App.Chip.Tonal" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textColor">@color/tonal_chip_text</item>
        <item name="android:ellipsize">end</item>
        <item name="chipBackgroundColor">@color/tonal_chip_background</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">@dimen/chip_corner</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
    </style>

    <!-- The same, for an entry that removes itself when tapped, so it never looks checked -->
    <style name="Widget.App.Chip.Tonal.Entry">
        <item name="android:checkable">false</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIcon">@drawable/ic_close_24dp</item>
        <item name="closeIconTint">?attr/colorOnSecondaryContainer</item>
        <item name="closeIconSize">@dimen/chip_close_icon_size</item>
    </style>

    <!-- A chip adding a ready made set of options -->
    <style name="Widget.App.Chip.Tonal.Shortcut">
        <item name="android:checkable">false</item>
        <item name="chipIcon">@drawable/ic_add_24dp</item>
        <item name="chipIconTint">?attr/colorOnSecondaryContainer</item>
        <item name="chipIconVisible">true</item>
    </style>

    <!-- A result of the dice: filled like a checked segment when it is the highest face -->
    <style name="Widget.App.Chip.Tonal.Result">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A link to the developer in the about page, one of a row sharing the width -->
    <style name="Widget.App.AuthorLink" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">@dimen/activity_vertical_margin</item>
        <item name="android:paddingBottom">@dimen/activity_vertical_margin</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>

    <!-- Custom color styles -->
    <style name="AppTheme.Accent" parent="AppTheme" />

